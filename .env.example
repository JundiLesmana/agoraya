# ══════════════════════════════════════════════════════════════════════════
# Agoraya — Environment variable reference
#
# Copy this file to `.env.local` and fill in real values locally.
# NEVER commit real secrets. Secret values belong in deployment secret
# storage (Vercel / Neon / Brevo dashboards), not in this repository.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser. Keep
# server-only secrets (API keys, DB credentials) out of NEXT_PUBLIC_*.
# ══════════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development                      # development | test | production
NEXT_PUBLIC_APP_URL=http://localhost:3000 # base URL used by the app (NEXT_PUBLIC_* is public)

# ── Database (PostgreSQL / Neon) ───────────────────────────────────────────
DATABASE_URL=                             # Neon pooled connection string
DATABASE_URL_UNPOOLED=                    # Direct connection string (for migrations)
CRON_SECRET=                              # server-only Vercel Cron bearer secret (at least 32 bytes)

# Local development (PostgreSQL CLI via scripts/setup-local-db.sh):
# DATABASE_URL=postgresql://agoraya:localdev@localhost:5432/agoraya_local
# DATABASE_URL_UNPOOLED=postgresql://agoraya:localdev@localhost:5432/agoraya_local

# ── Auth & OTP ─────────────────────────────────────────────────────────────
AUTH_SECRET=                              # random secret for session encryption (server-only)
OTP_EXPIRY_MINUTES=5                      # OTP lifetime in minutes
OTP_MAX_ATTEMPTS=3                        # maximum attempts per OTP code

# ── Brevo (transactional email) ─────────────────────────────────────────────
BREVO_API_KEY=                            # server-only API key from the Brevo dashboard
BREVO_SENDER_EMAIL=                       # verified sender address
BREVO_SENDER_NAME=                        # sender display name

# ── Cloudinary (media CDN) ──────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=        # cloud name (safe to expose)
CLOUDINARY_API_KEY=                       # API key (server-only)
CLOUDINARY_API_SECRET=                    # API secret (server-only)

# ── BPS API (public government statistics) ──────────────────────────────────
BPS_API_KEY=                              # API key for the government statistics API (webapi.bps.go.id)

# ── AI providers (optional, adapter-driven) ─────────────────────────────────
AI_PROVIDER=                              # gemini | cerebras | groq | openrouter
AI_API_KEY=                               # API key for the configured provider
