#App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
REPORTING_TENANT_ID=                         # ID UUID tenant penerima laporan; samakan dengan tenant ASN
CITIZEN_KYC_TENANT_ID=                       # ID UUID tenant ASN penerima antrean KYC warga
ASN_KYC_TENANT_ID=                           # ID UUID tenant reviewer penerima antrean KYC ASN; fallback ke CITIZEN_KYC_TENANT_ID

DATABASE_URL=postgres://agoraya:localdev@127.0.0.1:5432/agoraya_local
DATABASE_URL_UNPOOLED=postgres://agoraya:localdev@127.0.0.1:5432/agoraya_local
CRON_SECRET=                              # server-only Vercel Cron bearer secret (at least 32 bytes)

#Auth & OTP 
AUTH_SECRET=                              # server-only random secret (at least 32 characters)
OTP_EXPIRY_MINUTES=5                      # OTP lifetime in minutes
OTP_MAX_ATTEMPTS=3                        # maximum attempts per OTP code

#Brevo
BREVO_API_KEY=                            # server-only API key from the Brevo dashboard
BREVO_SENDER_EMAIL=                       # verified sender address
BREVO_SENDER_NAME=                        # sender display name

# ── Cloudinary (media CDN)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=        # cloud name (safe to expose)
CLOUDINARY_API_KEY=                       # API key (server-only)
CLOUDINARY_API_SECRET=                    # API secret (server-only)

# ── BPS API (public government statistics)
BPS_API_KEY=                              # API key for the government statistics API (webapi.bps.go.id)
BPS_STATISTICS_INDICATORS=0000:413:0:0,0000:192:434:61,0000:1886:585:0,0000:847:0:0 # domain:var:turvar:turtahun (IPM, poverty, population, sanitation)

#AI providers (optional, adapter-driven)
AI_PROVIDER=                              # gemini | cerebras | groq | openrouter
AI_API_KEY=                               # API key for the configured provider

# Local-only test accounts; used by pnpm db:seed:local-accounts.
LOCAL_SEED_TENANT_NAME="Agoraya Local Testing"
LOCAL_SEED_EXECUTIVE_PASSWORD=
LOCAL_SEED_ADMIN_PASSWORD=
LOCAL_SEED_CITIZEN_PASSWORD=

#One-time Neon production account bootstrap
BOOTSTRAP_TENANT_NAME=Komdigi
BOOTSTRAP_EXECUTIVE_EMAIL=executive@agoraya.com
BOOTSTRAP_EXECUTIVE_NAME=Executive Agoraya
BOOTSTRAP_EXECUTIVE_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@agoraya.com
BOOTSTRAP_ADMIN_NAME=Admin Agoraya
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_CITIZEN_EMAIL=citizen@agoraya.com
BOOTSTRAP_CITIZEN_NAME=Citizen Agoraya
BOOTSTRAP_CITIZEN_PASSWORD=
