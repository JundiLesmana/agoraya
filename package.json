{
  "name": "agoraya",
  "version": "0.1.0",
  "private": true,
  "description": "Agoraya — platform transparansi, pelaporan publik, dan tata kelola pemerintahan digital untuk Indonesia.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:security": "vitest run tests/security --passWithNoTests",
    "test:load": "vitest run tests/load --passWithNoTests",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:security && pnpm test:load",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:local": "drizzle-kit migrate --config drizzle.config.local.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:push:local": "drizzle-kit push --config drizzle.config.local.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:studio:local": "drizzle-kit studio --config drizzle.config.local.ts",
    "db:seed": "tsx db/seed/index.ts",
    "db:reset": "tsx scripts/reset-demo.ts",
    "db:rollback": "tsx scripts/rollback-migration.ts",
    "script:seed": "tsx scripts/seed.ts",
    "script:reset-demo": "tsx scripts/reset-demo.ts",
    "script:verify-audit": "tsx scripts/verify-audit.ts",
    "script:export-snapshot": "tsx scripts/export-snapshot.ts",
    "seed": "tsx scripts/seed.ts",
    "reset-demo": "tsx scripts/reset-demo.ts",
    "verify-audit": "tsx scripts/verify-audit.ts",
    "export-snapshot": "tsx scripts/export-snapshot.ts",
    "db:reset-demo": "tsx scripts/reset-demo.ts",
    "ci:security": "pnpm lint && pnpm test:security"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.2.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.60.0",
    "maplibre-gl": "^6.15.0",
    "next": "15",
    "postgres": "^3.4.9",
    "radix-ui": "1",
    "react": "19",
    "react-dom": "19",
    "react-hook-form": "7",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "9",
    "eslint-config-next": "15",
    "eslint-plugin-security": "^4.2.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4",
    "tsx": "^4.23.15",
    "typescript": "5",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
